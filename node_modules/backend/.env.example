# Server
NODE_ENV=development
PORT=5000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173

# Database (PostgreSQL 16)
DATABASE_URL=postgresql://brightloop:brightloop_pass@localhost:5432/brightloop_db
DB_HOST=localhost
DB_PORT=5432
DB_USER=brightloop
DB_PASSWORD=brightloop_pass
DB_NAME=brightloop_db
DB_POOL_MIN=2
DB_POOL_MAX=20

# Authentication & JWT Secrets
JWT_ACCESS_SECRET=brightloop_dev_access_secret_super_secure_32_chars_min!
JWT_REFRESH_SECRET=brightloop_dev_refresh_secret_super_secure_32_chars_min!
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Email / MailHog (SMTP localhost:1025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Brightloop Billing" <billing@brightloop.local>

# Application Rules
LOCKOUT_THRESHOLD=5
LOCKOUT_DURATION_MINUTES=15
RESET_TOKEN_EXPIRATION_MINUTES=30
